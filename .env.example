# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=your-client-secret
BOT_OWNER_ID=000000000000000000

# Database (PostgreSQL required; schema uses scalar lists + Json columns)
DATABASE_URL=postgresql://user:password@localhost:5432/vibe

# AI Providers (configure at least one)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
HF_API_KEY=

# Application
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Feature flags
ENABLE_CONVERSATIONAL_CHANNELS=false
ENABLE_AUTOMOD=false
ENABLE_TICKETS=false
ENABLE_APPLICATIONS=false

# Rate limits (per minute)
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_PER_USER=10
RATE_LIMIT_PER_GUILD=100

# Task configuration
TASK_TIMEOUT_MS=300000
MAX_TOOL_CALLS_PER_TASK=50
MAX_MODEL_CALLS_PER_TASK=20

# Provider ordering
PROVIDER_ORDER=groq,gemini,openrouter,cerebras,nvidia,huggingface
DEFAULT_PROVIDER=groq
FAILOVER_MAX_IMMEDIATE_ATTEMPTS=3
FAILOVER_TASK_BUDGET_MS=600000
